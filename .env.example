# Jinder Environment Variables Template
# Copy this file to '.env' and fill in your actual values.

# Gemini API Key for matching jobs with your CV (required for matching)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use
GEMINI_MODEL=gemini-2.5-flash-lite

# Backend server port
PORT=5000

# Optional bearer token protecting the API. When set, every /api request
# must send "Authorization: Bearer <token>". Leave unset for open local use.
#AUTH_TOKEN=change-me

# Allowed CORS origin for the API (only relevant when the frontend is served
# from a different origin; dev proxy and production are same-origin).
#CORS_ORIGIN=http://localhost:5173

# Allow scraping private/localhost URLs (normally blocked as SSRF protection).
#ALLOW_PRIVATE_URLS=false
