{
  "name": "jinder",
  "version": "1.0.0",
  "description": "Self-hosted AI-powered job scraper, CV matcher, and application tracker for the Hungarian tech market",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && npm run frontend:build",
    "build:server": "tsc",
    "start": "node dist/server.js",
    "frontend:dev": "npm --prefix client run dev",
    "frontend:build": "npm --prefix client run build",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:e2e": "tsx tests/e2e/run-tests.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "job-scraper",
    "gemini",
    "cv-matching",
    "playwright"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^2.8.0",
    "axios": "^1.17.0",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "playwright": "^1.60.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
